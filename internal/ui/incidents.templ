package ui

import (
	"strconv"
	"time"

	"github.com/jcwearn/alert-agent/internal/store"
)

// IncidentList is the home page.
templ IncidentList(incidents []IncidentRow, awaiting []store.PullRequest, now time.Time) {
	@layout("Incidents") {
		if len(awaiting) > 0 {
			<h1>Awaiting review ({ strconv.Itoa(len(awaiting)) })</h1>
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>PR</th>
							<th>CI</th>
							<th class="hide-narrow">Incident</th>
							<th>Opened</th>
						</tr>
					</thead>
					<tbody>
						for _, pr := range awaiting {
							<tr>
								<td>
									<a href={ templ.URL(pr.URL) } rel="noreferrer">#{ strconv.Itoa(pr.Number) }</a>
									<div class="muted">{ pr.Title }</div>
								</td>
								<td>
									@statusBadge(pr.Checks)
								</td>
								<td class="hide-narrow">
									<a href={ incidentURL(pr.IncidentID) }>#{ strconv.FormatInt(pr.IncidentID, 10) } { pr.AlertName }</a>
									<div class="muted">{ pr.Namespace }</div>
								</td>
								<td title={ stamp(pr.CreatedAt) }>{ ago(pr.CreatedAt, now) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<h1>Incidents</h1>
		if len(incidents) == 0 {
			<p class="muted">No incidents yet. They appear here when Alertmanager sends one.</p>
		} else {
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Status</th>
							<th>Alert</th>
							<th class="hide-narrow">Namespace</th>
							<th class="hide-narrow">Severity</th>
							<th>Opened</th>
						</tr>
					</thead>
					<tbody>
						for _, in := range incidents {
							<tr>
								<td>
									@statusBadge(in.Status)
								</td>
								<td>
									<a href={ incidentURL(in.ID) }>{ in.AlertName }</a>
									if in.AlertCount > 1 {
										<span class="muted">× { strconv.Itoa(in.AlertCount) }</span>
									}
									if len(in.Children) > 0 {
										<span class="muted">+{ strconv.Itoa(len(in.Children)) } merged</span>
									}
									@linkChips(in.Links)
									if in.Summary != "" {
										<div class="muted">{ in.Summary }</div>
									}
								</td>
								<td class="hide-narrow">{ in.Namespace }</td>
								<td class="hide-narrow">{ in.Severity }</td>
								<td title={ stamp(in.OpenedAt) }>{ ago(in.OpenedAt, now) }</td>
							</tr>
							for _, c := range in.Children {
								<tr class="child">
									<td>
										@statusBadge(c.AlertStatus)
									</td>
									<td>
										<span class="muted">↳ merged</span>
										<a href={ incidentURL(c.ID) }>{ c.AlertName }</a>
										@linkChips(c.Links)
									</td>
									<td class="hide-narrow">{ c.Namespace }</td>
									<td class="hide-narrow">{ c.Severity }</td>
									<td title={ stamp(c.OpenedAt) }>{ ago(c.OpenedAt, now) }</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ linkChips(ids []int64) {
	for _, id := range ids {
		<a class="chip" href={ incidentURL(id) } title="related incident">↔ { idStr(id) }</a>
	}
}

// IncidentDetail is one incident: its alerts, runs, PR, related incidents
// and audit trail.
templ IncidentDetail(p IncidentPage) {
	@layout(p.Incident.AlertName) {
		<h1>
			@statusBadge(p.Incident.AlertStatus)
			{ p.Incident.AlertName }
		</h1>
		if p.Notice != "" {
			<div class="card notice">{ p.Notice }</div>
		}
		if p.Problem != "" {
			<div class="card notice error">{ p.Problem }</div>
		}
		if p.Incident.ParentID != nil {
			<div class="card merged">
				<p>
					Merged into
					<a href={ incidentURL(*p.Incident.ParentID) }>
						{ idStr(*p.Incident.ParentID) }
						if p.Parent != nil {
							{ p.Parent.AlertName }
						}
					</a>
					by
					if u, ok := mergedByRun(p.Incident.MergedBy); ok {
						<a href={ u }>{ mergedByLabel(p.Incident.MergedBy) }</a>
					} else {
						{ mergedByLabel(p.Incident.MergedBy) }
					}
					if p.Incident.MergedAt != nil {
						<span class="muted">· { stamp(*p.Incident.MergedAt) }</span>
					}
				</p>
				if p.Incident.MergeReason != "" {
					<p class="muted">{ p.Incident.MergeReason }</p>
				}
				<form method="post" action={ templ.SafeURL("/incidents/" + strconv.FormatInt(p.Incident.ID, 10) + "/unmerge") }>
					<button type="submit">Unmerge</button>
				</form>
			</div>
		}
		<div class="card">
			<dl>
				<dt>Incident</dt>
				<dd>{ idStr(p.Incident.ID) }</dd>
				<dt>Namespace</dt>
				<dd>{ p.Incident.Namespace }</dd>
				<dt>Severity</dt>
				<dd>{ p.Incident.Severity }</dd>
				<dt>Summary</dt>
				<dd>{ p.Incident.Summary }</dd>
				<dt>Opened</dt>
				<dd>{ stamp(p.Incident.OpenedAt) }</dd>
				<dt>Last update</dt>
				<dd>{ stamp(p.Incident.UpdatedAt) }</dd>
				if p.Incident.ResolvedAt != nil {
					<dt>Resolved</dt>
					<dd>{ stamp(*p.Incident.ResolvedAt) }</dd>
				}
			</dl>
		</div>
		if pr := p.PR; pr != nil {
			<h2>Pull request</h2>
			<div class="card">
				<p>
					@statusBadge(pr.State)
					<a href={ templ.URL(pr.URL) } rel="noreferrer">#{ strconv.Itoa(pr.Number) } { pr.Title }</a>
				</p>
				<dl>
					<dt>CI</dt>
					<dd>
						@statusBadge(pr.Checks)
					</dd>
					<dt>Branch</dt>
					<dd class="mono">{ pr.Branch }</dd>
					<dt>Proposed by</dt>
					<dd><a href={ runURL(pr.RunID) }>run #{ strconv.FormatInt(pr.RunID, 10) }</a></dd>
					<dt>Opened</dt>
					<dd>{ stamp(pr.CreatedAt) }</dd>
					if pr.ClosedAt != nil {
						<dt>{ pr.State }</dt>
						<dd>{ stamp(*pr.ClosedAt) }</dd>
					}
				</dl>
			</div>
		}
		if p.PR != nil {
			@chatPanel(p)
		}
		@related(p)
		@runList(p.Runs)
		<h2>Alerts ({ strconv.Itoa(len(p.Alerts)) })</h2>
		for _, a := range p.Alerts {
			<div class="card">
				<p>
					@statusBadge(a.Status)
					<span class="muted">since { stamp(a.StartsAt) }</span>
					if a.GeneratorURL != "" {
						· <a href={ templ.URL(a.GeneratorURL) } rel="noreferrer">source</a>
					}
				</p>
				if d := a.Annotations["description"]; d != "" {
					<p>{ d }</p>
				}
				<div class="chips">
					for _, l := range sorted(a.Labels) {
						<span class="chip">{ l.K }={ l.V }</span>
					}
				</div>
			</div>
		}
		@activity(p.Actions)
	}
}

// related shows merged children and links, with the forms that change them.
templ related(p IncidentPage) {
	<h2>Related</h2>
	<div class="card">
		if len(p.Children) > 0 {
			<p class="muted">Merged into this incident:</p>
			<ul class="plain">
				for _, c := range p.Children {
					<li>
						@statusBadge(c.AlertStatus)
						<a href={ incidentURL(c.ID) }>{ idStr(c.ID) } { c.AlertName }</a>
						<span class="muted">by { mergedByLabel(c.MergedBy) }: { c.MergeReason }</span>
					</li>
				}
			</ul>
		}
		if len(p.Links) > 0 {
			<p class="muted">Linked as related:</p>
			<ul class="plain">
				for _, l := range p.Links {
					<li>
						@statusBadge(l.Other.AlertStatus)
						<a href={ incidentURL(l.Other.ID) }>{ idStr(l.Other.ID) } { l.Other.AlertName }</a>
						<span class="muted">{ l.Other.Namespace } · { l.Reason }</span>
						<form class="inline" method="post" action={ templ.SafeURL("/incidents/" + strconv.FormatInt(p.Incident.ID, 10) + "/unlink") }>
							<input type="hidden" name="other" value={ strconv.FormatInt(l.Other.ID, 10) }/>
							<button type="submit">Unlink</button>
						</form>
					</li>
				}
			</ul>
		}
		if len(p.Children) == 0 && len(p.Links) == 0 {
			<p class="muted">No merged or linked incidents.</p>
		}
		if len(p.Candidates) > 0 {
			<div class="forms">
				if p.Incident.ParentID == nil {
					@pickerForm(p, "merge", "into", "Merge into…", "Same problem: this incident folds into the one you pick.")
				}
				@pickerForm(p, "link", "other", "Link to…", "Related, but a different problem.")
			</div>
		}
	</div>
}

templ pickerForm(p IncidentPage, action, field, label, hint string) {
	<form method="post" action={ templ.SafeURL("/incidents/" + strconv.FormatInt(p.Incident.ID, 10) + "/" + action) }>
		<label>
			<span>{ label }</span>
			<select name={ field } required>
				<option value="">choose an incident</option>
				for _, c := range p.Candidates {
					<option value={ strconv.FormatInt(c.ID, 10) }>{ candidateLabel(c) }</option>
				}
			</select>
		</label>
		<input type="text" name="reason" maxlength="1024" placeholder="reason (optional)"/>
		<button type="submit">{ label }</button>
		<div class="muted hint">{ hint }</div>
	</form>
}

// activity is the incident's audit trail: every tool call and every merge
// or link that names it, by the agent or a human.
templ activity(actions []store.Action) {
	<h2>Activity ({ strconv.Itoa(len(actions)) })</h2>
	if len(actions) == 0 {
		<p class="muted">Nothing recorded yet.</p>
	} else {
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th>When</th>
						<th>Action</th>
						<th>By</th>
						<th>Outcome</th>
					</tr>
				</thead>
				<tbody>
					for _, a := range actions {
						<tr>
							<td>{ stamp(a.CreatedAt) }</td>
							<td>
								<span class="mono">{ a.Tool }</span>
								<span class="muted">
									{ idStr(a.IncidentID) }
									if a.TargetIncidentID != nil {
										→ { idStr(*a.TargetIncidentID) }
									}
								</span>
								if s := actionSummary(a); s != "" {
									<div class="muted">{ s }</div>
								}
							</td>
							<td>
								if a.RunID != nil {
									<a href={ runURL(*a.RunID) }>{ actorLabel(a) } · run #{ strconv.FormatInt(*a.RunID, 10) }</a>
								} else {
									{ actorLabel(a) }
								}
							</td>
							<td>
								@statusBadge(a.Status)
								if a.Result != "" {
									<div class="muted">{ a.Result }</div>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

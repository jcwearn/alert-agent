package ui

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · alert-agent</title>
			<link rel="stylesheet" href={ assetURL("chat.css") }/>
			<script src={ assetURL("chat.js") } defer></script>
			<style>
				/* Colour tokens. Surfaces step up bg → card → chip; borders (line)
				   must stand out from both bg and card, which in dark mode is what
				   separates a card from the page. accent fills the chat launcher and
				   your messages. ui/contrast_test.go checks the pairs that matter. */
				:root {
					color-scheme: light;
					--bg: #f7f7f5; --fg: #1d1d1b; --muted: #6b6b66; --line: #e2e2dc; --card: #ffffff;
					--firing: #b42318; --firing-bg: #fdecea; --resolved: #1f7a3d; --resolved-bg: #e7f4ec;
					--chip: #efefea; --accent: #1d1d1b; --on-accent: #f7f7f5;
				}
				@media (prefers-color-scheme: dark) {
					:root {
						color-scheme: dark;
						--bg: #1a1a18; --fg: #ededE8; --muted: #b0b0a7; --line: #4f4f4a; --card: #292927;
						--firing: #ff9a90; --firing-bg: #4a1f1b; --resolved: #86d9a2; --resolved-bg: #1c3d27;
						--chip: #383835; --accent: #3d5a86; --on-accent: #f2f5fa;
					}
				}
				* { box-sizing: border-box; }
				body { margin: 0; background: var(--bg); color: var(--fg);
					font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, sans-serif; }
				header { border-bottom: 1px solid var(--line); padding: 12px 16px; }
				header a { color: inherit; text-decoration: none; font-weight: 600; }
				main { max-width: 1100px; margin: 0 auto; padding: 16px; }
				h1 { font-size: 20px; margin: 0 0 12px; }
				h2 { font-size: 16px; margin: 24px 0 8px; }
				a { color: inherit; }
				.muted { color: var(--muted); }
				table { width: 100%; border-collapse: collapse; background: var(--card);
					border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
				th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
				th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); font-weight: 600; }
				tr:last-child td { border-bottom: 0; }
				.status { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; }
				.status-firing { color: var(--firing); background: var(--firing-bg); }
				.status-resolved { color: var(--resolved); background: var(--resolved-bg); }
				.chips { display: flex; flex-wrap: wrap; gap: 4px; }
				.chip { background: var(--chip); border-radius: 4px; padding: 0 6px; font: 12px/1.6 ui-monospace, monospace; }
				.card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; margin-bottom: 10px; }
				dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 0; }
				dt { color: var(--muted); }
				dd { margin: 0; overflow-wrap: anywhere; }
				.table-wrap { overflow-x: auto; }
				.mono { font: 13px/1.5 ui-monospace, monospace; overflow-wrap: anywhere; }
				.report { white-space: pre-wrap; overflow-wrap: anywhere; }
				.report.error, details.error summary { color: var(--firing); }
				.step { margin: 6px 0; padding: 8px 12px; border-left: 3px solid var(--line); background: var(--card); border-radius: 0 6px 6px 0; }
				.step-text { white-space: pre-wrap; border-left-color: var(--fg); }
				.md { white-space: normal; }
				.md > :first-child { margin-top: 0; }
				.md > :last-child { margin-bottom: 0; }
				.md h1, .md h2, .md h3 { font-size: 15px; margin: 14px 0 4px; }
				.md p, .md ul, .md ol, .md pre, .md table { margin: 6px 0; }
				.md ul, .md ol { padding-left: 22px; }
				.md code { font: 12px/1.5 ui-monospace, monospace; background: var(--chip); padding: 1px 4px; border-radius: 4px; }
				.md pre { background: var(--chip); padding: 8px 10px; border-radius: 6px; overflow-x: auto; white-space: pre; }
				.md pre code { background: none; padding: 0; }
				.md table { border-collapse: collapse; }
				.md th, .md td { border: 1px solid var(--chip); padding: 2px 8px; }
				.step-tool { border-left-color: var(--muted); }
				.step-note { font-size: 13px; }
				.step-meta { font-size: 13px; }
				.step pre { margin: 6px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; font: 12px/1.5 ui-monospace, monospace; max-height: 480px; overflow-y: auto; }
				summary { cursor: pointer; font-size: 13px; color: var(--muted); }
				.status-queued, .status-running { color: var(--fg); background: var(--chip); }
				.status-succeeded { color: var(--resolved); background: var(--resolved-bg); }
				.status-failed { color: var(--firing); background: var(--firing-bg); }
				.status-skipped { color: var(--muted); background: var(--chip); }
				.status-open, .status-pending { color: var(--fg); background: var(--chip); }
				.status-merged, .status-success { color: var(--resolved); background: var(--resolved-bg); }
				.status-closed { color: var(--muted); background: var(--chip); }
				.status-failure { color: var(--firing); background: var(--firing-bg); }
				.status-started, .status-rejected { color: var(--muted); background: var(--chip); }
				tr.child td { background: var(--bg); }
				tr.child td:first-child { padding-left: 22px; }
				a.chip { text-decoration: none; margin-left: 4px; }
				.notice.error, .merged { border-color: var(--firing); }
				.merged p { margin: 0 0 6px; }
				ul.plain { list-style: none; padding: 0; margin: 4px 0 10px; }
				ul.plain li { margin: 4px 0; }
				form.inline { display: inline; margin-left: 6px; }
				.forms { display: grid; gap: 12px; margin-top: 8px; border-top: 1px solid var(--line); padding-top: 10px; }
				.forms label { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
				.forms input[type=text] { width: 100%; margin: 6px 0; }
				select, input, button { font: inherit; color: var(--fg); background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; max-width: 100%; }
				button { cursor: pointer; }
				:focus-visible { outline: 2px solid var(--muted); outline-offset: 2px; }
				.hint { font-size: 13px; }
				.chip.kind { font-size: 12px; margin-left: 6px; }
				.title-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
				.title-row h1 { margin: 0; }
				@media (max-width: 640px) { .hide-narrow { display: none; } }
			</style>
		</head>
		<body>
			<header><a href="/">alert-agent</a></header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

templ statusBadge(status string) {
	<span class={ "status", "status-" + status }>{ status }</span>
}
